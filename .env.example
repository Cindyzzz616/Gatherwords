EXPO_PUBLIC_GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key
# On a physical device, use your computer's LAN IP address, not 127.0.0.1.
EXPO_PUBLIC_TRANSCRIPTION_URL=http://192.168.1.10:8000
# Optional; defaults to the transcription server URL.
EXPO_PUBLIC_PRACTICE_SERVER_URL=http://192.168.1.10:8000
# Server-only OpenAI configuration. Never use EXPO_PUBLIC_ for this key.
OPENAI_API_KEY=your_openai_api_key
OPENAI_PRACTICE_MODEL=gpt-4.1-mini
# Optional when Linq runs on a different server than transcription.
EXPO_PUBLIC_LINQ_SERVER_URL=http://192.168.1.10:8000
LINQ_API_KEY=your_linq_api_key
LINQ_PHONE_NUMBER=your_linq_phone_number
LINQ_WEBHOOK_SECRET=whsec_your_linq_webhook_signing_secret
# Absolute path to a Firebase service-account JSON file; never expose this file to the app.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
